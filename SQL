write the sql query to find the recent order date

 WITH RankedOrders AS (
    SELECT 
        customer_id,
        order_date,
        amount,
        ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY order_date DESC) as rn
    FROM orders
)
SELECT 
    c.name,
    ro.order_date AS recent_order_date,
    ro.amount
FROM customers c
JOIN RankedOrders ro ON c.customer_id = ro.customer_id
WHERE ro.rn = 1;

